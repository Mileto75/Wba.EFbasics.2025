@model HorsesIndexViewModel

<h5>@ViewBag.PageTitle</h5>
<div class="row">
    <div class="col col-lg-4">
        @* error messages *@
        @if (TempData.ContainsKey("errorMessage"))
        {
            <div class="alert alert-danger" role="alert">
                @TempData["errorMessage"]
            </div>
        }
        @* show user messages *@
        @if (TempData.ContainsKey("message"))
        {
            <div class="alert alert-primary" role="alert">
                @TempData["message"]
            </div>
        }
        <a asp-controller="Horses" asp-action="Add" class="btn btn-outline-info">Add</a>
    </div>
</div>
<div class="row">
    @foreach(var horse in Model.Horses)
    { 
        <div class="col col-lg-3 border border-1 rounded rounded-2 m-1 p-1 text-center">
            <div>
                <p>@horse.Value</p>
                <p>
                    <a asp-controller="Horses" asp-action="Info" asp-route-id="@horse.Id"
                       class="btn btn-outline-info">Info</a>
                <a asp-controller="Horses" asp-action="Edit" asp-route-id="@horse.Id" 
                      class="btn btn-outline-warning">Edit</a>
                <a asp-controller="Horses" asp-action="ConfirmDelete" asp-route-id="@horse.Id" 
                      class="btn btn-outline-danger">Delete</a>
                </p>
            </div>
        </div>
    }
</div>

