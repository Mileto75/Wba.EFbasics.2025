@model HorsesAddViewModel

<div class="row">
    <div class="col col-lg-5 mx-auto">
        <h5>Add new Horse</h5>
        <form asp-controller="Horses" asp-action="Add" method="post" enctype="multipart/form-data">
            @* call the HorsesFormPartial *@
            <partial name="_HorsesFormPartial" model="@Model" />
            <a asp-controller="Horses" asp-action="Index" class="btn btn-outline-warning mt-2">Cancel</a>
        </form>
    </div>
</div>